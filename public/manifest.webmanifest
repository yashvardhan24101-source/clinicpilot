{
  "name": "ClinicPilot — Staff Dashboard",
  "short_name": "ClinicPilot",
  "description": "WhatsApp-based admin assistant and staff dashboard for small clinics and diagnostic labs",
  "start_url": "/today",
  "id": "/today",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F5F8FB",
  "theme_color": "#F5F8FB",
  "scope": "/",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's Schedule",
      "short_name": "Today",
      "description": "View today's live patient schedule and queue",
      "url": "/today",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "WhatsApp Inbox",
      "short_name": "Inbox",
      "description": "Check conversations needing staff takeover",
      "url": "/inbox",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New Appointment",
      "short_name": "New Appt",
      "description": "Book a new walk-in or patient appointment",
      "url": "/today?action=new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
