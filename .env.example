# ClinicPilot Environment Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CLINIC_NAME="SmileCraft Dental Clinic"

# Security & Session Authentication
# Must be a 32+ character random string in production
SESSION_SECRET=dev-clinicpilot-secret-replace-with-32-chars-in-production

# Demo Mode Flags (Must be false in production)
# Server-only flag for security decisions & mock bypass
DEMO_MODE=false
# Client flag only for displaying the visual demo banner & demo UI toggles
NEXT_PUBLIC_DEMO_MODE=false

# Feature Flags (Default false in production)
FEATURE_PATIENT_PORTAL=false
FEATURE_DOCTOR_CHAMBER=false
FEATURE_DIGITAL_RX=false
FEATURE_PUBLIC_DOCTOR_SEARCH=false

# Production Bootstrap Owner (Used when DEMO_MODE=false)
# Generate bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 10))"
# IMPORTANT: In .env and .env.local files, Next.js uses dotenv-expand. You MUST escape every '$' with '\$'
# (e.g. "\$2b\$10\$..."), otherwise dotenv-expand treats '$2b' and '$10' as empty environment variables!
BOOTSTRAP_OWNER_EMAIL=director@yourclinic.in
BOOTSTRAP_OWNER_PASSWORD_HASH="\$2b\$10\$FAKEplaceholderHashDoNotUseInProductionXXXXXXXXXXXXXXXXXXXXX"
BOOTSTRAP_CLINIC_ID=cln-prod-1
BOOTSTRAP_CLINIC_NAME="Your Clinic Name"

# Distributed Rate Limiting (Required in production: Upstash Redis or Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Messaging & Telecom Providers
# Options: mock | fast2sms | 2factor | twilio
OTP_PROVIDER=mock
FAST2SMS_API_KEY=
